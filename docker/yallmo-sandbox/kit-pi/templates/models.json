{
  "providers": {
    "sbx-openai": {
      "name": "Sandbox ChatGPT (host OAuth)",
      "baseUrl": "https://chatgpt.com/backend-api/codex",
      "api": "openai-responses",
      "headers": {
        "OpenAI-Beta": "responses=experimental",
        "originator": "pi"
      },
      "compat": {
        "supportsMaxOutputTokens": false,
        "supportsLongCacheRetention": false
      },
      "models": [
        {
          "id": "gpt-6.1-sol",
          "name": "GPT-6.1 Sol (Sandbox ChatGPT)",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": null,
            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "input": [
            "text",
            "image"
          ],
          "contextWindow": 500000,
          "maxTokens": 128000,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "samplingParams": {
            "instructions": "You are a coding assistant. Follow the developer instructions supplied in the input.",
            "store": false
          }
        }
      ]
    },
    "docker-mr": {
      "name": "Docker Model Runner",
      "baseUrl": "http://host.docker.internal:12434/engines/v1",
      "api": "openai-completions",
      "apiKey": "docker-mr",
      "models": [
        {
          "id": "ai/gemma4:E4B",
          "name": "Gemma (Docker Model Runner)"
        }
      ]
    }
  }
}
