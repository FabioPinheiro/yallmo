# Defense in depth: ignore any state created using the removed shared-credential instructions.
# This directory is NOT mounted by sbxenv.yaml. Never commit any credentials found here.
/pi-agent/
# Local work stays local, except the intentionally committed sample.
/workspace/*
!/workspace/hello.py
!/workspace/yallmo.yaml
!/workspace/server.sh
# Keep the storage directory in the example, never commit its runtime contents.
!/workspace/storage/
/workspace/storage/*
!/workspace/storage/.gitkeep
/sbxenv.local.yaml
