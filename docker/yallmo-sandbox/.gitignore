# Keep Pi credentials, sessions and runtime state private; version skills only.
!/pi/
/pi/*
!/pi/agent/
/pi/agent/*
!/pi/agent/skills/

/workspace/*
!/workspace/hello.py
/yallmo-workspace/*
!/yallmo-workspace/server.sh
!/yallmo-workspace/yallmo.yaml
!/yallmo-workspace/storage/
/yallmo-workspace/storage/*
!/yallmo-workspace/storage/.gitkeep
/sbxenv.local.yaml
/__pycache__/
/kit-*/__pycache__/
