{
  "providers": {
    "sbx-openai": {
      "name": "Sandbox ChatGPT (host OAuth)",
      "baseUrl": "https://chatgpt.com/backend-api/codex",
      "api": "openai-responses",
      "headers": {
        "OpenAI-Beta": "responses=experimental",
        "originator": "pi"
      },
      "compat": {
        "supportsMaxOutputTokens": false,
        "supportsLongCacheRetention": false
      },
      "models": [
        {
          "id": "gpt-6.1-sol",
          "name": "Sandbox ChatGPT",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "low",
            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": null,
            "max": null
          },
          "input": ["text", "image"],
          "contextWindow": 128000,
          "maxTokens": 16384,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
          "samplingParams": {
            "instructions": "You are a coding assistant. Follow the developer instructions supplied in the input.",
            "store": false
          }
        }
      ]
    }
  }
}
