# Automatically selected by: docker build -f docker/Dockerfile .
# Deny by default. Include exact input files/source trees, not their whole parent directories.
# Keep this Dockerfile-specific so Sandbox kit contexts retain their separate inputs.
**

# sbt build definition and production sources (shared + required platform-specific trees).
!build.sbt
!.sbtopts
!project/build.properties
!project/plugins.sbt
!model/shared/src/main/**
!model/jvm/src/main/**
!model/js/src/main/**
!filesystem/shared/src/main/**
!filesystem/jvm/src/main/**
!scalacode-api/shared/src/main/**
!scalacode-api/jvm/src/main/**
!core/shared/src/main/**
!core/jvm/src/main/**
!protocol/shared/src/main/**
!rpc/shared/src/main/**
!rpc/jvm/src/main/**
!client-harness/shared/src/main/**
!repl/src/main/**
!server/src/main/**
!web-harness/src/main/**

# Frontend build inputs only: no node_modules, npm credentials, or generated output.
!web-harness/vite/package.json
!web-harness/vite/package-lock.json
!web-harness/vite/*.js
!web-harness/vite/*.css
!web-harness/vite/*.html
!browser-STT-TTS/package.json
!browser-STT-TTS/*.js
!browser-STT-TTS/*.css
!browser-STT-TTS/*.html

# Files copied by the image Dockerfile. Publishing/tests/sandbox state stay excluded.
!docker/Dockerfile
!docker/image/install-sbt.py
!docker/image/install-coursier.py
!docker/image/coursier-env.sh
!docker/image/coursier-tool.sh
!docker/image/entrypoint.sh

# Defense in depth inside admitted source/resource trees. Never put secrets in source files.
**/.env
**/.env.*
**/.npmrc
**/.netrc
**/.pypirc
**/.git
**/.pi
**/.ssh
**/.aws
**/.config
**/auth.json
**/*.pem
**/*.key
**/*.log
**/yallmo.json
**/yallmo.yaml
**/yallmo.yml
**/server-storage
